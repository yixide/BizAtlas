{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizatlas.dev/schema/v0/map.schema.json",
  "title": "BizAtlas 业务对象地图 v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "description",
        "generatedAt"
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          }
        }
      },
      "required": [
        "positions"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "domains",
    "objects",
    "relations",
    "tables",
    "flows"
  ],
  "$defs": {
    "confidence": {
      "enum": [
        "confirmed",
        "inferred"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "file",
        "line"
      ]
    },
    "evidenceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "claim": {
      "allOf": [{"if":{"properties":{"confidence":{"const":"confirmed"}},"required":["confidence"]},"then":{"properties":{"evidence":{"type":"array","minItems":1}}}}],
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        }
      },
      "required": [
        "text",
        "confidence",
        "evidence"
      ]
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ]
    },
    "table": {
      "allOf": [{"if":{"properties":{"confidence":{"const":"confirmed"}},"required":["confidence"]},"then":{"properties":{"evidence":{"type":"array","minItems":1}}}}],
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tableName": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        }
      },
      "required": [
        "id",
        "name",
        "tableName",
        "confidence",
        "evidence"
      ]
    },
    "object": {
      "allOf": [{"if":{"properties":{"confidence":{"const":"confirmed"}},"required":["confidence"]},"then":{"properties":{"evidence":{"type":"array","minItems":1}}}}],
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domainId": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "$ref": "#/$defs/claim"
        },
        "tableRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tableId": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "primary",
                  "supporting"
                ]
              }
            },
            "required": [
              "tableId",
              "role"
            ]
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "importance": {
          "enum": [
            "core",
            "normal"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        }
      },
      "required": [
        "id",
        "name",
        "domainId",
        "summary",
        "tableRefs",
        "prerequisites",
        "confidence",
        "evidence"
      ]
    },
    "relation": {
      "allOf": [{"if":{"properties":{"confidence":{"const":"confirmed"}},"required":["confidence"]},"then":{"properties":{"evidence":{"type":"array","minItems":1}}}}],
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "owns",
            "belongs-to",
            "uses",
            "associates"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "cardinality": {
          "enum": [
            "1-1",
            "1-n",
            "n-n"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "type",
        "label",
        "cardinality",
        "confidence",
        "evidence"
      ]
    },
    "step": {
      "allOf": [{"if":{"properties":{"confidence":{"const":"confirmed"}},"required":["confidence"]},"then":{"properties":{"evidence":{"type":"array","minItems":1}}}}],
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "objectIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        }
      },
      "required": [
        "id",
        "description",
        "objectIds",
        "reads",
        "writes",
        "confidence",
        "evidence"
      ]
    },
    "flow": {
      "allOf": [{"if":{"properties":{"confidence":{"const":"confirmed"}},"required":["confidence"]},"then":{"properties":{"evidence":{"type":"array","minItems":1}}}}],
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "objectIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "objectIds",
        "steps",
        "confidence",
        "evidence"
      ]
    }
  }
}
